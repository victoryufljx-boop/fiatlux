# Pedone (2006) partial-charge rigid-ion potential, Er-Al3-SiO2, NVT
units metal
atom_style charge
boundary p p p
read_data ${data}
variable seed index 12345
variable thigh index 6000
variable nhigh index 20000
variable nmelt index 50000
variable nquench index 640000
variable nfinal index 50000
variable tag index r0
pair_style hybrid/overlay coul/dsf 0.25 8.0 pedone 5.5
pair_coeff * * coul/dsf
# pedone: D0(eV) alpha(1/A) r0(A) C0(eV A^12); types 1 Si 2 Al 3 Er 4 O
pair_coeff 1 4 pedone 0.340554 2.006700 2.100000 1.0
pair_coeff 2 4 pedone 0.361581 1.900442 2.164818 0.9
pair_coeff 3 4 pedone 0.040448 2.294078 2.837722 3.0
pair_coeff 4 4 pedone 0.042395 1.379316 3.618701 22.0
neighbor 1.0 bin
neigh_modify every 1 delay 0 check yes
timestep 0.001
thermo 5000
thermo_style custom step temp pe etotal press
thermo_modify flush yes
min_style cg
minimize 1e-6 1e-8 2000 20000
reset_timestep 0
# relax random-placement contacts
velocity all create 3000 ${seed} mom yes rot yes dist gaussian
fix lim all nve/limit 0.05
fix lan all langevin 3000 ${thigh} 0.1 ${seed}
run 3000
unfix lim
unfix lan
fix nvt all nvt temp ${thigh} ${thigh} 0.1
run ${nhigh}
unfix nvt
fix nvt all nvt temp ${thigh} 3500 0.1
run 2000
unfix nvt
fix nvt all nvt temp 3500 3500 0.1
run ${nmelt}
write_data ${tag}_3500K.data
unfix nvt
fix nvt all nvt temp 3500 300 0.1
run ${nquench}
write_data ${tag}_quenched.data
unfix nvt
fix nvt all nvt temp 300 300 0.1
variable n1 equal ${nfinal}-20000
run ${n1}
dump d all custom 2000 ${tag}_final.dump id type x y z
dump_modify d sort id
run 20000
write_data ${tag}_300K.data
