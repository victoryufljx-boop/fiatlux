# Er-Ge10-SiO2 melt-quench, Pedone 2006 potential
# vars: seed, tmelt, nmelt, nhold, ncool, nfinal, rcoul
units metal
atom_style charge
boundary p p p
read_data start.data
pair_style table linear 12000
pair_coeff 1 1 all.table O_O
pair_coeff 1 2 all.table O_Si
pair_coeff 1 3 all.table O_Ge
pair_coeff 1 4 all.table O_Er
pair_coeff 2 2 all.table Si_Si
pair_coeff 2 3 all.table Si_Ge
pair_coeff 2 4 all.table Si_Er
pair_coeff 3 3 all.table Ge_Ge
pair_coeff 3 4 all.table Ge_Er
pair_coeff 4 4 all.table Er_Er
neighbor 1.0 bin
neigh_modify every 1 delay 0 check yes
timestep 0.001
thermo_style custom step temp pe etotal press
thermo 2000
thermo_modify flush yes

min_style cg
minimize 1.0e-6 1.0e-8 2000 20000
reset_timestep 0

# gentle start from random packing
velocity all create ${tmelt} ${seed} mom yes rot yes dist gaussian
fix lim all nve/limit 0.05
fix ber all temp/berendsen ${tmelt} ${tmelt} 0.05
run 3000
unfix lim
unfix ber
reset_timestep 0

# melt
fix nvt all nvt temp ${tmelt} ${tmelt} 0.1
run ${nmelt}
unfix nvt
write_restart melt.restart
# 3500 K hold
fix nvt all nvt temp 3500 3500 0.1
run ${nhold}
unfix nvt
write_restart hold.restart
# linear quench 3500 -> 300 K
fix nvt all nvt temp 3500 300 0.1
run ${ncool}
unfix nvt
write_restart cool.restart
# 300 K production; dump 10 frames over last 20 ps
fix nvt all nvt temp 300 300 0.1
variable nfirst equal ${nfinal}-20000
run ${nfirst}
dump d all custom 2000 final.dump id type x y z
dump_modify d sort id
run 20000
undump d
write_data final.data
