# resume from a restart (stage-aware via global timestep): cool 70000->390000, 300 K to 440000
units metal
atom_style charge
read_restart ${rfile}
pair_style table linear 12000
pair_coeff 1 1 all.table O_O
pair_coeff 1 2 all.table O_Si
pair_coeff 1 3 all.table O_Ge
pair_coeff 1 4 all.table O_Er
pair_coeff 2 2 all.table Si_Si
pair_coeff 2 3 all.table Si_Ge
pair_coeff 2 4 all.table Si_Er
pair_coeff 3 3 all.table Ge_Ge
pair_coeff 3 4 all.table Ge_Er
pair_coeff 4 4 all.table Er_Er
neighbor 1.0 bin
neigh_modify every 1 delay 0 check yes
timestep 0.001
thermo_style custom step temp pe etotal press
thermo 2000
thermo_modify flush yes
restart 10000 rs.a rs.b
variable s0 equal step
if "${s0} < 390000" then "fix nvt all nvt temp 3500 300 0.1" "run 390000 upto start 70000 stop 390000" "unfix nvt" "write_restart cool.restart"
fix nvt all nvt temp 300 300 0.1
if "${s0} < 420000" then "run 420000 upto"
dump d all custom 2000 final.dump id type x y z
dump_modify d sort id
run 440000 upto
undump d
write_data final.data
